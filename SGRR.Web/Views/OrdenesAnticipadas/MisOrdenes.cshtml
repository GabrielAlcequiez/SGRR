@model IReadOnlyList<SGRR.Web.Models.Ordenes.OrdenAnticipadaViewModel>
@{
    ViewData["Title"] = "Mis órdenes anticipadas";
    var ordenCreada = ViewBag.OrdenCreadaCode as string;
    string BadgeClass(string estado) => estado switch
    {
        "Pendiente" => "bg-warning text-dark",
        "Aceptada" => "bg-success",
        "Rechazada" => "bg-danger",
        "Entregada" => "bg-secondary",
        _ => "bg-light text-dark"
    };
}

<h1 class="h2 mb-1">Mis órdenes anticipadas</h1>
<p class="text-muted">Historial de tus pedidos programados.</p>

@if (!string.IsNullOrEmpty(ordenCreada))
{
    <div class="alert alert-success" role="status">
        Orden <strong>@ordenCreada</strong> registrada correctamente. Estado inicial:
        <span class="badge bg-warning text-dark">Pendiente</span>
    </div>
}

@if (TempData["PagoError"] is string pagoError)
{
    <div class="alert alert-danger" role="alert">@pagoError</div>
}

@if (TempData["PagoExito"] is string pagoExito)
{
    <div class="alert alert-success" role="status">@pagoExito</div>
}
<a asp-controller="Client" asp-action="Index" class="btn btn-primary mb-3">Buscar restaurante</a>

@if (Model.Count == 0)
{
    <p>No tienes órdenes anticipadas registradas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Restaurante</th>
                    <th>Productos</th>
                    <th>Programada</th>
                    <th>Entrega</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var orden in Model)
                {
                    <tr class="@(orden.PurchaseCode == ordenCreada ? "table-success" : null)">
                        <td>@orden.PurchaseCode</td>
                        <td>@orden.RestaurantName</td>
                        <td class="text-break">@string.Join(", ", orden.Productos)</td>
                        <td>@orden.FechaProgramada.ToString("dd/MM/yyyy") @orden.HoraProgramada.ToString(@"hh\:mm")</td>
                        <td>
                            @orden.TipoEntrega
                            @if (!string.IsNullOrWhiteSpace(orden.DireccionEntrega))
                            {
                                <div class="text-muted small">@orden.DireccionEntrega</div>
                            }
                        </td>
                        <td>$@orden.Total.ToString("N2")</td>
                        <td><span class="badge @BadgeClass(orden.Estado)">@orden.Estado</span></td>
                        <td>
                            <a asp-controller="Pagos"
                               asp-action="Index"
                               asp-route-id="@orden.Id"
                               class="btn btn-sm btn-success">
                                Proceder al pago
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
