@model SGRR.Web.Models.Ordenes.CreateOrdenAnticipadaDto
@using System.Globalization
@{
    ViewData["Title"] = "Ordenar con anticipación";
    var menu = (Dictionary<string, List<SGRR.Data.Entities.MenuItem>>)ViewBag.CategorizedMenu;
    var horario = ViewBag.ScheduleText as string;
    var horaMinima = (string)ViewBag.HoraMinima;

    int CantidadSeleccionada(Guid menuItemId) =>
        Model.Items?.FirstOrDefault(item => item.MenuItemId == menuItemId)?.Cantidad ?? 0;
}

<h1 class="h2 mb-1">Ordenar con anticipación</h1>
<p class="text-muted">@Model.RestaurantName</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger border-start border-4 border-danger shadow-sm" role="alert">
        @Model.ErrorMessage
    </div>
}

<form asp-action="Crear" method="post">
    <input type="hidden" asp-for="RestaurantId" />

    <div class="row g-4">
        <div class="col-lg-7">
            <h2 class="h5 border-bottom pb-2">1. Elige tus productos</h2>
            @if (menu.Count == 0)
            {
                <div class="alert alert-warning" role="alert">
                    Este restaurante no tiene platillos disponibles en su menú en este momento.
                </div>
            }
            else
            {
                var indice = 0;
                foreach (var categoria in menu)
                {
                    <h3 class="h6 text-uppercase text-secondary mt-4">@categoria.Key</h3>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <tbody>
                                @foreach (var item in categoria.Value)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold text-break">@item.Name</span>
                                            <div class="text-muted small text-break">@item.Description</div>
                                        </td>
                                        <td class="text-nowrap">$@item.Price.ToString("N2")</td>
                                        <td style="width: 110px;">
                                            <input type="hidden" name="Items[@indice].MenuItemId" value="@item.Id" />
                                            <input type="number" class="form-control cantidad-producto" name="Items[@indice].Cantidad"
                                                   value="@CantidadSeleccionada(item.Id)" min="0" max="100"
                                                   data-precio="@item.Price.ToString(CultureInfo.InvariantCulture)"
                                                   aria-label="Cantidad de @item.Name" />
                                        </td>
                                    </tr>
                                    indice++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-dark text-white fw-bold py-3">2. Programa tu orden</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="FechaProgramada" class="form-label fw-semibold">Fecha *</label>
                        <input asp-for="FechaProgramada" type="date" class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        <span asp-validation-for="FechaProgramada" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HoraProgramada" class="form-label fw-semibold">Hora *</label>
                        <input asp-for="HoraProgramada" type="time" class="form-control" min="@horaMinima" required />
                        <span asp-validation-for="HoraProgramada" class="text-danger small"></span>
                        @if (!string.IsNullOrEmpty(horario))
                        {
                            <div class="form-text">@horario</div>
                        }
                        else
                        {
                            <div class="form-text text-warning">El restaurante no atiende en la fecha seleccionada.</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="TipoEntrega" class="form-label fw-semibold">Tipo de entrega *</label>
                        <select asp-for="TipoEntrega" class="form-select">
                            <option value="Recoger">Recoger en el restaurante</option>
                            <option value="Delivery">Delivery</option>
                        </select>
                    </div>

                    <div class="mb-3 d-none" id="bloqueDireccion">
                        <label asp-for="DireccionEntrega" class="form-label fw-semibold">Dirección de entrega *</label>
                        <input asp-for="DireccionEntrega" class="form-control" placeholder="Calle, número, referencia" />
                        <span asp-validation-for="DireccionEntrega" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notas" class="form-label fw-semibold">Notas (opcional)</label>
                        <textarea asp-for="Notas" class="form-control" rows="2" placeholder="Ej. sin picante, empacar aparte..."></textarea>
                        <span asp-validation-for="Notas" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <span class="fw-semibold">Total:</span>
                        <span class="fs-4 fw-bold text-success">$<span id="totalOrden">0.00</span></span>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 mt-3 shadow fw-bold" disabled="@(menu.Count == 0)">
                        Confirmar orden
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const cantidades = document.querySelectorAll('.cantidad-producto');
            const totalTexto = document.getElementById('totalOrden');
            const fecha = document.getElementById('FechaProgramada');
            const hora = document.getElementById('HoraProgramada');
            const tipoEntrega = document.getElementById('TipoEntrega');
            const bloqueDireccion = document.getElementById('bloqueDireccion');

            function actualizarTotal() {
                let total = 0;
                cantidades.forEach(function (input) {
                    const cantidad = parseInt(input.value, 10) || 0;
                    if (cantidad > 0) {
                        total += cantidad * parseFloat(input.dataset.precio);
                    }
                });
                totalTexto.textContent = total.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function actualizarHoraMinima() {
                if (!fecha.value) {
                    return;
                }
                const hoy = new Date();
                const yyyy = hoy.getFullYear();
                const mm = String(hoy.getMonth() + 1).padStart(2, '0');
                const dd = String(hoy.getDate()).padStart(2, '0');
                if (fecha.value === `${yyyy}-${mm}-${dd}`) {
                    hoy.setMinutes(hoy.getMinutes() + 30);
                    const hh = String(hoy.getHours()).padStart(2, '0');
                    const min = String(hoy.getMinutes()).padStart(2, '0');
                    hora.min = `${hh}:${min}`;
                    if (hora.value && hora.value < hora.min) {
                        hora.value = hora.min;
                    }
                } else {
                    hora.min = '00:00';
                }
            }

            function actualizarDireccion() {
                bloqueDireccion.classList.toggle('d-none', tipoEntrega.value !== 'Delivery');
            }

            cantidades.forEach(function (input) {
                input.addEventListener('input', actualizarTotal);
            });
            fecha.addEventListener('change', actualizarHoraMinima);
            tipoEntrega.addEventListener('change', actualizarDireccion);

            actualizarTotal();
            actualizarHoraMinima();
            actualizarDireccion();
        })();
    </script>
}
