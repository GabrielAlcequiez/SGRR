@model SGRR.Data.Entities.Restaurant

@{
    ViewData["Title"] = "Mi restaurante";
}

<h1 class="h2 mb-4">Mi restaurante</h1>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model is null)
{
    <div class="alert alert-info">Todavía no tienes un restaurante asociado.</div>
    <a class="btn btn-primary" asp-controller="Restaurant" asp-action="Create">Crear perfil del restaurante</a>
}
else
{
    <div class="card">
        <div class="card-body">
            <h2 class="h4 text-break">@Model.Name</h2>
            <dl class="row mb-3">
                <dt class="col-sm-3">Especialidad</dt>
                <dd class="col-sm-9 text-break">@Model.Specialty</dd>
                <dt class="col-sm-3">Ubicación</dt>
                <dd class="col-sm-9 text-break">@Model.Location</dd>
                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9 text-break">@(string.IsNullOrWhiteSpace(Model.Description) ? "Sin descripción." : Model.Description)</dd>
            </dl>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" asp-controller="Restaurant" asp-action="Edit" asp-route-id="@Model.Id">Editar perfil</a>
                <a class="btn btn-outline-primary" asp-controller="Dish" asp-action="Index">Mi menú</a>
            </div>
        </div>
    </div>
}