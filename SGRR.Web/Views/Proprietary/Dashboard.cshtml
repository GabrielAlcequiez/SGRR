@using SGRR.Data.Common.Enums
@model SGRR.Web.Models.Owner.OwnerDashboardDto

@{
    ViewData["Title"] = "Panel de Estadísticas y Analítica";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-graph-up-arrow"></i> Panel de Estadísticas y Analítica</h2>
        
        <!-- Selector de Filtro de Tiempo (RF-13) -->
        <form method="get" asp-action="Dashboard" class="d-flex align-items-center gap-2">
            <label for="filter" class="fw-bold me-2">Período:</label>
            <select name="filter" id="filter" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="@TimeRangeFilter.AllTime" selected="@(Model.CurrentFilter == TimeRangeFilter.AllTime)">Histórico Completo</option>
                <option value="@TimeRangeFilter.Last7Days" selected="@(Model.CurrentFilter == TimeRangeFilter.Last7Days)">Últimos 7 días</option>
                <option value="@TimeRangeFilter.Today" selected="@(Model.CurrentFilter == TimeRangeFilter.Today)">Hoy</option>
            </select>
        </form>
    </div>

    <!-- Tarjetas KPI (RF-13) -->
    <div class="row g-3 mb-4">
        <!-- Ingresos Totales -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-white-50">Ingresos Totales Acumulados</h6>
                    <h3 class="card-title fw-bold mb-0">@Model.TotalRevenue.ToString("C")</h3>
                </div>
            </div>
        </div>

        <!-- Órdenes Completadas -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-white-50">Órdenes Completadas</h6>
                    <h3 class="card-title fw-bold mb-0">@Model.CompletedOrdersCount</h3>
                </div>
            </div>
        </div>

        <!-- Ticket Promedio -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-dark-50">Ticket Promedio</h6>
                    <h3 class="card-title fw-bold mb-0">@Model.AverageTicket.ToString("C")</h3>
                </div>
            </div>
        </div>

        <!-- Reservas Confirmadas -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-info text-white h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-white-50">Reservas Confirmadas</h6>
                    <h3 class="card-title fw-bold mb-0">@Model.ConfirmedReservationsCount</h3>
                </div>
            </div>
        </div>
    </div>
</div>