@using SGRR.Data.Common.Enums
@model SGRR.Web.Models.Reports.AdminReportsViewModel

@{
    ViewData["Title"] = "Reportes de la Plataforma";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-file-earmark-bar-graph"></i> Reportes de la Plataforma</h2>

        <!-- Formulario parametrizado: tipo de reporte + rango de fechas (calendarios) -->
        <form method="get" asp-action="Reports" class="d-flex align-items-center gap-2">
            <label for="reportType" class="fw-bold">Reporte:</label>
            <select name="reportType" id="reportType" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="@((int)AdminReportType.RestaurantPerformance)" selected="@(Model.SelectedType == AdminReportType.RestaurantPerformance)">Rendimiento por Restaurante</option>
                <option value="@((int)AdminReportType.GlobalSalesBalance)" selected="@(Model.SelectedType == AdminReportType.GlobalSalesBalance)">Balance de Ventas</option>
            </select>

            <label for="startDate" class="fw-bold ms-2">Desde:</label>
            <input type="date" id="startDate" name="startDate" class="form-control form-control-sm"
                   value="@Model.StartDate.ToString("yyyy-MM-dd")" required />

            <label for="endDate" class="fw-bold">Hasta:</label>
            <input type="date" id="endDate" name="endDate" class="form-control form-control-sm"
                   value="@Model.EndDate.ToString("yyyy-MM-dd")" required />

            <button type="submit" class="btn btn-sm btn-primary">Generar</button>
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Botón de descarga en archivo plano CSV con los mismos parámetros del reporte -->
    <div class="mb-3">
        <a class="btn btn-success" asp-controller="Admin" asp-action="ExportCsv"
           asp-route-reportType="@((int)Model.SelectedType)"
           asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
           title="Descargar el reporte en archivo plano delimitado por comas">
            <i class="bi bi-filetype-csv"></i> Descargar CSV
        </a>
    </div>

    <!-- Tabla previa de resultados antes de la descarga -->
    @if (Model.SelectedType == AdminReportType.RestaurantPerformance)
    {
        <h5 class="mb-3">Vista previa: Rendimiento por Restaurante (@Model.StartDate.ToString("dd/MM/yyyy") al @Model.EndDate.ToString("dd/MM/yyyy"))</h5>
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Restaurante</th>
                        <th>Especialidad</th>
                        <th>Ubicación</th>
                        <th>Calificación</th>
                        <th>Reseñas</th>
                        <th>Pedidos Completados</th>
                        <th>Ingresos Totales</th>
                        <th>Ticket Promedio</th>
                        <th>Reservas Confirmadas</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.PerformanceRows.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted">No hay datos en el rango de fechas seleccionado.</td></tr>
                    }
                    @foreach (var row in Model.PerformanceRows)
                    {
                        <tr>
                            <td class="fw-semibold">@row.RestaurantName</td>
                            <td>@row.Specialty</td>
                            <td>@row.Location</td>
                            <td>@(row.Rating?.ToString("0.0") ?? "-")</td>
                            <td>@row.ReviewCount</td>
                            <td>@row.CompletedOrdersCount</td>
                            <td>@row.TotalRevenue.ToString("N2")</td>
                            <td>@row.AverageTicket.ToString("N2")</td>
                            <td>@row.ConfirmedReservationsCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <h5 class="mb-3">Vista previa: Balance de Ventas (@Model.StartDate.ToString("dd/MM/yyyy") al @Model.EndDate.ToString("dd/MM/yyyy"))</h5>
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Restaurante</th>
                        <th>Cantidad de Pedidos</th>
                        <th>Ingresos Totales</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.SalesRows.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted">No hay datos en el rango de fechas seleccionado.</td></tr>
                    }
                    @foreach (var row in Model.SalesRows)
                    {
                        <tr>
                            <td class="fw-semibold">@row.Date.ToString("dd/MM/yyyy")</td>
                            <td>@row.RestaurantName</td>
                            <td>@row.OrdersCount</td>
                            <td>@row.TotalRevenue.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
