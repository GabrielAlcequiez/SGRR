@model IEnumerable<SGRR.Data.Entities.User>
@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container mt-4">
    <h2>Gestión de Usuarios y Restaurantes</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mt-4">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Name @user.LastName</td>
                            <td>@user.Email</td>
                            <td>@user.Role.ToString()</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Bloqueado</span>
                                }
                            </td>
                            <td>
                                <form asp-controller="Admin" asp-action="ToggleStatus" method="post" style="display:inline;">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <!-- Enviamos lo contrario al estado actual para hacer el Toggle -->
                                    <input type="hidden" name="isActive" value="@(user.IsActive ? "false" : "true")" />
                                    
                                    @if (user.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                onclick="return confirm('¿Estás seguro de que deseas BLOQUEAR este usuario?');">
                                            Bloquear
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            Habilitar
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>