@model SGRR.Web.ViewModels.ProcesarPagoViewModel

@{
    ViewData["Title"] = "Procesar pago";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">Procesar pago</h1>

                    <p class="text-muted">
                        Orden <strong>@Model.PurchaseCode</strong>
                    </p>

                    <div class="alert alert-info" role="status">
                        <strong>Monto total:</strong>
                        $@Model.MontoTotal.ToString("N2")
                    </div>

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"></div>

                    <form asp-controller="Pagos"
                          asp-action="Procesar"
                          asp-route-id="@Model.OrdenAnticipadaId"
                          method="post">
                        <div class="mb-3">
                            <label asp-for="MetodoPago" class="form-label"></label>
                            <select asp-for="MetodoPago" class="form-select">
                                <option value="">Selecciona un método</option>
                                <option value="Credito">Tarjeta de crédito</option>
                                <option value="Debito">Tarjeta de débito</option>
                            </select>
                            <span asp-validation-for="MetodoPago" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NumeroTarjeta" class="form-label"></label>
                            <input asp-for="NumeroTarjeta"
                                   class="form-control"
                                   type="text"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   maxlength="23"
                                   aria-describedby="numeroTarjetaAyuda" />
                            <div id="numeroTarjetaAyuda" class="form-text">
                                No se almacenará el número de tarjeta.
                            </div>
                            <span asp-validation-for="NumeroTarjeta" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaExpiracion" class="form-label"></label>
                                <input asp-for="FechaExpiracion"
                                       class="form-control"
                                       type="text"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       placeholder="MM/AA"
                                       maxlength="5" />
                                <span asp-validation-for="FechaExpiracion" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Cvv" class="form-label"></label>
                                <input asp-for="Cvv"
                                       class="form-control"
                                       type="password"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       maxlength="4" />
                                <span asp-validation-for="Cvv" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button type="submit" class="btn btn-success">
                                Pagar
                            </button>

                            <a asp-controller="OrdenesAnticipadas"
                               asp-action="MisOrdenes"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <a asp-controller="Client"
                               asp-action="Index"
                               class="btn btn-outline-primary">
                                Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}