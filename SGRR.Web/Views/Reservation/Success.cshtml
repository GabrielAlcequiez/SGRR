@model SGRR.Web.Models.ReservationDetailsViewModel

@{
    ViewData["Title"] = "Reserva Confirmada";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0 rounded-3 bg-white text-center">
        <!-- Banner de Confirmación -->
        <div class="card-header bg-success text-white py-4 rounded-top">
            <h2 class="m-0 fw-bold">Reserva Confirmada Exitosamente</h2>
            <p class="mb-0 small opacity-75">Guarde su código de confirmación para su registro</p>
        </div>

        <div class="card-body p-4 text-start">
            <!-- Bloque Destacado del Código Único -->
            <div class="bg-light border text-center p-3 rounded-3 mb-4">
                <span class="text-muted small d-block text-uppercase fw-semibold tracking-wider">Código de Reserva</span>
                <span class="display-6 fw-bold text-success font-monospace">@Model.ReservationCode</span>
            </div>

            <!-- Tabla de Detalles Consolidados -->
            <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Detalles del Registro</h5>
            <div class="list-group list-group-flush mb-4">
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                    <span class="text-muted fw-semibold">Establecimiento:</span>
                    <span class="text-dark fw-bold">@Model.RestaurantName</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                    <span class="text-muted fw-semibold">Fecha Reservada:</span>
                    <span class="text-dark fw-bold">@Model.Date</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                    <span class="text-muted fw-semibold">Horario Asignado:</span>
                    <span class="text-dark fw-bold">@Model.TimeSlot</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                    <span class="text-muted fw-semibold">Número de Asistentes:</span>
                    <span class="text-dark fw-bold">@Model.PeopleCount</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                    <span class="text-muted fw-semibold">Área Asignada:</span>
                    <span class="text-dark fw-bold">@Model.TableLocation</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                    <span class="text-muted fw-semibold">Estado Actual:</span>
                    <span class="badge bg-success px-3 py-2 text-uppercase">@Model.Status</span>
                </div>
            </div>

            <!-- Botones de Acción Posterior -->
            <div class="row g-2">
                <div class="col-12">
                    <a asp-controller="Reservation" asp-action="Index" class="btn btn-primary btn-lg w-100 py-3 fw-bold text-uppercase shadow-sm">
                        Ver mis reservas
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
