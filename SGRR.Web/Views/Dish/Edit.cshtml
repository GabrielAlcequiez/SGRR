@model SGRR.Web.Models.Dish.UpdateDishDto
@{
    ViewData["Title"] = "Editar plato";
}
<h1 class="h2">Editar plato</h1>
<p class="text-muted">@ViewBag.RestaurantName</p>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nombre</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Price" class="form-label">Precio</label>
        <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Descripción</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Category" class="form-label">Categoría</label>
        <input asp-for="Category" class="form-control" placeholder="Platos Fuertes, Entradas, Bebidas..." />
        <span asp-validation-for="Category" class="text-danger"></span>
        <div class="form-text">Se usa para agrupar el menú del cliente. Si lo dejas vacío se guarda en "Otros".</div>
    </div>
    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label">URL de imagen (opcional)</label>
        <input asp-for="ImageUrl" type="url" class="form-control" placeholder="https://..." />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al menú</a>
</form>
