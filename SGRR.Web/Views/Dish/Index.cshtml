@model IEnumerable<SGRR.Data.Entities.Dish>
@{
    ViewData["Title"] = "Mi menú";
}

<h1 class="h2">Mi menú</h1>
<p class="text-muted">@ViewBag.RestaurantName</p>
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
<div class="d-flex gap-2 mb-4">
    <a class="btn btn-primary" asp-action="Create">Agregar plato</a>
    <a class="btn btn-outline-secondary" asp-controller="Proprietary" asp-action="Dashboard">Mi restaurante</a>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info" role="status">Todavía no tienes platos en tu menú.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr><th>Nombre</th><th>Precio</th><th>Descripción</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var dish in Model)
                {
                    <tr>
                        <td class="text-break">@dish.Name</td>
                        <td>@dish.Price.ToString("N2")</td>
                        <td class="text-break">@dish.Description</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@dish.Id">Editar</a>
                                <form asp-action="Delete" asp-route-id="@dish.Id" method="post" onsubmit="return confirm('¿Eliminar este plato?');">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
