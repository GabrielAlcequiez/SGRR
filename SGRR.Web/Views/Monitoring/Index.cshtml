@model SGRR.Web.Models.Monitoring.PlatformDashboardDto
@{
    ViewData["Title"] = "Monitoreo de Plataforma";
}

<div class="container mt-4">
    <h2 class="mb-4">📈 Salud Operativa de la Plataforma</h2>

    <!-- Widgets -->
    <div class="row text-center mb-5">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Clientes Registrados</h5>
                    <h2 class="display-6 fw-bold">@Model.TotalClients</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Restaurantes Activos</h5>
                    <h2 class="display-6 fw-bold">@Model.ActiveRestaurants</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-secondary mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Restaurantes Inactivos</h5>
                    <h2 class="display-6 fw-bold">@Model.InactiveRestaurants</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-dark bg-info mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Transacciones del Día</h5>
                    <h2 class="display-6 fw-bold">@Model.DailyTransactions</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Buscador -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>📋 Últimos 100 Eventos del Sistema</h4>
        <input type="text" id="logSearch" class="form-control w-25" placeholder="🔍 Buscar eventos..." onkeyup="filterLogs()">
    </div>

    <!-- Tabla Circular de Logs -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0" id="logsTable">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 20%;">Fecha y Hora (UTC)</th>
                        <th style="width: 15%;">Severidad</th>
                        <th>Detalle del Evento</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentLogs.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center p-3">No hay registros recientes de auditoría.</td>
                        </tr>
                    }
                    @foreach (var log in Model.RecentLogs)
                    {
                        <tr>
                            <td class="text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                @switch (log.Severity)
                                {
                                    case SGRR.Data.Common.Enums.LogSeverity.Info:
                                        <span class="badge bg-primary w-100">Info</span>
                                        break;
                                    case SGRR.Data.Common.Enums.LogSeverity.Warning:
                                        <span class="badge bg-warning text-dark w-100">Warning</span>
                                        break;
                                    case SGRR.Data.Common.Enums.LogSeverity.Error:
                                        <span class="badge bg-danger w-100">Error</span>
                                        break;
                                }
                            </td>
                            <td class="log-message">@log.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterLogs() {
        let input = document.getElementById("logSearch").value.toLowerCase();
        let table = document.getElementById("logsTable");
        let tr = table.getElementsByTagName("tr");

        for (let i = 1; i < tr.length; i++) { // Salta el thead
            let tdMessage = tr[i].getElementsByTagName("td")[2];
            let tdSeverity = tr[i].getElementsByTagName("td")[1];
            
            if (tdMessage || tdSeverity) {
                let txtValue = (tdMessage.textContent || tdMessage.innerText) + " " + (tdSeverity.textContent || tdSeverity.innerText);
                if (txtValue.toLowerCase().indexOf(input) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
</script>   