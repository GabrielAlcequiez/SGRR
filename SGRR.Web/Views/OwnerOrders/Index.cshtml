@model IReadOnlyList<SGRR.Web.Models.Ordenes.OrdenAnticipadaViewModel>
@{
    ViewData["Title"] = "Órdenes anticipadas";
    string BadgeClass(string estado) => estado switch
    {
        "Pendiente" => "bg-warning text-dark",
        "Aceptada" => "bg-success",
        "Rechazada" => "bg-danger",
        "Entregada" => "bg-secondary",
        _ => "bg-light text-dark"
    };
}

<div class="container mt-4">
    <h2>Órdenes anticipadas</h2>
    <p class="text-muted">@ViewBag.RestaurantName</p>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="status">No tienes órdenes anticipadas registradas por el momento.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Productos</th>
                        <th>Programada</th>
                        <th>Entrega</th>
                        <th>Notas</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var orden in Model)
                    {
                        <tr>
                            <td>@orden.PurchaseCode</td>
                            <td>@orden.ClientName</td>
                            <td class="text-break">@string.Join(", ", orden.Productos)</td>
                            <td>@orden.FechaProgramada.ToString("dd/MM/yyyy") @orden.HoraProgramada.ToString(@"hh\:mm")</td>
                            <td>
                                @orden.TipoEntrega
                                @if (!string.IsNullOrWhiteSpace(orden.DireccionEntrega))
                                {
                                    <div class="text-muted small">@orden.DireccionEntrega</div>
                                }
                            </td>
                            <td class="text-break">@orden.Notas</td>
                            <td>$@orden.Total.ToString("N2")</td>
                            <td><span class="badge @BadgeClass(orden.Estado)">@orden.Estado</span></td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (orden.Estado == "Pendiente")
                                    {
                                        <form asp-action="Aceptar" asp-route-id="@orden.Id" method="post">
                                            <button class="btn btn-sm btn-outline-success" type="submit">Aceptar</button>
                                        </form>
                                        <form asp-action="Rechazar" asp-route-id="@orden.Id" method="post" onsubmit="return confirm('¿Rechazar esta orden?');">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Rechazar</button>
                                        </form>
                                    }
                                    else if (orden.Estado == "Aceptada")
                                    {
                                        <form asp-action="MarcarEntregada" asp-route-id="@orden.Id" method="post">
                                            <button class="btn btn-sm btn-outline-primary" type="submit">Marcar entregada</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
